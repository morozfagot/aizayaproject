{
  "name": "morozcode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "MorozOrg",
  "version": "2.4.20",
  "icon": "assets/icons/icon.png",
  "galleryBanner": {
    "color": "#617A91",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.84.0",
    "node": "20.20.2"
  },
  "author": {
    "name": "Morozcode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morozfagot/aizayaproject"
  },
  "homepage": "https://github.com/morozfagot/aizayaproject",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "cline",
    "claude",
    "dev",
    "mcp",
    "openrouter",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "sonnet",
    "ai",
    "llama",
    "morozcode",
    "morozfagot"
  ],
  "activationEvents": [
    "onLanguage",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "morozcode-ActivityBar",
          "title": "%views.activitybar.title%",
          "icon": "assets/icons/icon.svg"
        }
      ]
    },
    "views": {
      "morozcode-ActivityBar": [
        {
          "type": "webview",
          "id": "morozcode.SidebarProvider",
          "name": "%views.sidebar.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "morozcode.plusButtonClicked",
        "title": "%command.newTask.title%",
        "icon": "$(edit)"
      },
      {
        "command": "morozcode.historyButtonClicked",
        "title": "%command.history.title%",
        "icon": "$(history)"
      },
      {
        "command": "morozcode.marketplaceButtonClicked",
        "title": "%command.marketplace.title%",
        "icon": "$(extensions)"
      },
      {
        "command": "morozcode.popoutButtonClicked",
        "title": "%command.openInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "morozcode.settingsButtonClicked",
        "title": "%command.settings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "morozcode.openInNewTab",
        "title": "%command.openInNewTab.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.explainCode",
        "title": "%command.explainCode.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.fixCode",
        "title": "%command.fixCode.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.improveCode",
        "title": "%command.improveCode.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.addToContext",
        "title": "%command.addToContext.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.newTask",
        "title": "%command.newTask.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.terminalAddToContext",
        "title": "%command.terminal.addToContext.title%",
        "category": "Terminal"
      },
      {
        "command": "morozcode.terminalFixCommand",
        "title": "%command.terminal.fixCommand.title%",
        "category": "Terminal"
      },
      {
        "command": "morozcode.terminalExplainCommand",
        "title": "%command.terminal.explainCommand.title%",
        "category": "Terminal"
      },
      {
        "command": "morozcode.setCustomStoragePath",
        "title": "%command.setCustomStoragePath.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.importSettings",
        "title": "%command.importSettings.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.focusInput",
        "title": "%command.focusInput.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.acceptInput",
        "title": "%command.acceptInput.title%",
        "category": "%configuration.title%"
      },
      {
        "command": "morozcode.toggleAutoApprove",
        "title": "%command.toggleAutoApprove.title%",
        "category": "%configuration.title%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "morozcode.contextMenu",
          "group": "1"
        }
      ],
      "morozcode.contextMenu": [
        {
          "command": "morozcode.addToContext",
          "group": "1_actions@1"
        },
        {
          "command": "morozcode.explainCode",
          "group": "1_actions@2"
        },
        {
          "command": "morozcode.improveCode",
          "group": "1_actions@3"
        }
      ],
      "terminal/context": [
        {
          "submenu": "morozcode.terminalMenu",
          "group": "2"
        }
      ],
      "morozcode.terminalMenu": [
        {
          "command": "morozcode.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "morozcode.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "morozcode.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ],
      "view/title": [
        {
          "command": "morozcode.plusButtonClicked",
          "group": "navigation@1",
          "when": "view == morozcode.SidebarProvider"
        },
        {
          "command": "morozcode.settingsButtonClicked",
          "group": "navigation@2",
          "when": "view == morozcode.SidebarProvider"
        },
        {
          "command": "morozcode.marketplaceButtonClicked",
          "group": "navigation@3",
          "when": "view == morozcode.SidebarProvider"
        },
        {
          "command": "morozcode.historyButtonClicked",
          "group": "overflow@1",
          "when": "view == morozcode.SidebarProvider"
        },
        {
          "command": "morozcode.popoutButtonClicked",
          "group": "overflow@2",
          "when": "view == morozcode.SidebarProvider"
        }
      ],
      "editor/title": [
        {
          "command": "morozcode.plusButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == morozcode.TabPanelProvider"
        },
        {
          "command": "morozcode.settingsButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == morozcode.TabPanelProvider"
        },
        {
          "command": "morozcode.marketplaceButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == morozcode.TabPanelProvider"
        },
        {
          "command": "morozcode.historyButtonClicked",
          "group": "overflow@1",
          "when": "activeWebviewPanelId == morozcode.TabPanelProvider"
        },
        {
          "command": "morozcode.popoutButtonClicked",
          "group": "overflow@2",
          "when": "activeWebviewPanelId == morozcode.TabPanelProvider"
        }
      ]
    },
    "keybindings": [
      {
        "command": "morozcode.addToContext",
        "key": "cmd+k cmd+a",
        "mac": "cmd+k cmd+a",
        "win": "ctrl+k ctrl+a",
        "linux": "ctrl+k ctrl+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "morozcode.toggleAutoApprove",
        "key": "cmd+alt+a",
        "mac": "cmd+alt+a",
        "win": "ctrl+alt+a",
        "linux": "ctrl+alt+a"
      }
    ],
    "submenus": [
      {
        "id": "morozcode.contextMenu",
        "label": "%views.contextMenu.label%"
      },
      {
        "id": "morozcode.terminalMenu",
        "label": "%views.terminalMenu.label%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "morozcode.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git log",
            "git diff",
            "git show"
          ],
          "description": "%commands.allowedCommands.description%"
        },
        "morozcode.deniedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%commands.deniedCommands.description%"
        },
        "morozcode.commandExecutionTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 600,
          "description": "%commands.commandExecutionTimeout.description%"
        },
        "morozcode.commandTimeoutAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%commands.commandTimeoutAllowlist.description%"
        },
        "morozcode.preventCompletionWithOpenTodos": {
          "type": "boolean",
          "default": false,
          "description": "%commands.preventCompletionWithOpenTodos.description%"
        },
        "morozcode.vsCodeLmModelSelector": {
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string",
              "description": "%settings.vsCodeLmModelSelector.vendor.description%"
            },
            "family": {
              "type": "string",
              "description": "%settings.vsCodeLmModelSelector.family.description%"
            }
          },
          "description": "%settings.vsCodeLmModelSelector.description%"
        },
        "morozcode.customStoragePath": {
          "type": "string",
          "default": "",
          "description": "%settings.customStoragePath.description%"
        },
        "morozcode.enableCodeActions": {
          "type": "boolean",
          "default": true,
          "description": "%settings.enableCodeActions.description%"
        },
        "morozcode.autoImportSettingsPath": {
          "type": "string",
          "default": "",
          "description": "%settings.autoImportSettingsPath.description%"
        },
        "morozcode.maximumIndexedFilesForFileSearch": {
          "type": "number",
          "default": 10000,
          "minimum": 5000,
          "maximum": 500000,
          "description": "%settings.maximumIndexedFilesForFileSearch.description%"
        },
        "morozcode.useAgentRules": {
          "type": "boolean",
          "default": true,
          "description": "%settings.useAgentRules.description%"
        },
        "morozcode.apiRequestTimeout": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "maximum": 3600,
          "description": "%settings.apiRequestTimeout.description%"
        },
        "morozcode.newTaskRequireTodos": {
          "type": "boolean",
          "default": false,
          "description": "%settings.newTaskRequireTodos.description%"
        },
        "morozcode.codeIndex.embeddingBatchSize": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 200,
          "description": "%settings.codeIndex.embeddingBatchSize.description%"
        },
        "morozcode.debug": {
          "type": "boolean",
          "default": false,
          "description": "%settings.debug.description%"
        },
        "morozcode.debugProxy.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%settings.debugProxy.enabled.description%",
          "markdownDescription": "%settings.debugProxy.enabled.description%"
        },
        "morozcode.debugProxy.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8888",
          "description": "%settings.debugProxy.serverUrl.description%",
          "markdownDescription": "%settings.debugProxy.serverUrl.description%"
        },
        "morozcode.debugProxy.tlsInsecure": {
          "type": "boolean",
          "default": false,
          "description": "%settings.debugProxy.tlsInsecure.description%",
          "markdownDescription": "%settings.debugProxy.tlsInsecure.description%"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint . --ext=ts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "pretest": "turbo run bundle --cwd ..",
    "pretest:coverage": "turbo run bundle --cwd ..",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "bundle": "node esbuild.mjs",
    "vscode:prepublish": "pnpm bundle --production",
    "vsix": "mkdirp ../bin && vsce package --no-dependencies --out ../bin",
    "publish:vsce": "npx @vscode/vsce publish --packagePath ../bin/morozcode-$npm_package_version.vsix",
    "publish:ovsx": "pnpm exec ovsx publish ../bin/morozcode-$npm_package_version.vsix --skip-duplicate",
    "publish:marketplace": "pnpm vsix && pnpm publish:vsce && pnpm publish:ovsx",
    "watch:bundle": "pnpm bundle --watch",
    "watch:tsc": "cd .. && tsc --noEmit --watch --project src/tsconfig.json",
    "clean": "rimraf README.md CHANGELOG.md LICENSE dist logs mock .turbo"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.51",
    "@ai-sdk/baseten": "^1.0.31",
    "@ai-sdk/deepseek": "^2.0.18",
    "@ai-sdk/fireworks": "^2.0.32",
    "@ai-sdk/google": "^3.0.22",
    "@ai-sdk/google-vertex": "^4.0.45",
    "@ai-sdk/mistral": "^3.0.19",
    "@ai-sdk/xai": "^3.0.48",
    "@anthropic-ai/sdk": "^0.37.0",
    "@anthropic-ai/vertex-sdk": "^0.7.0",
    "@aws-sdk/client-bedrock-runtime": "^3.922.0",
    "@aws-sdk/credential-providers": "^3.922.0",
    "@google/genai": "^1.29.1",
    "@lmstudio/sdk": "^1.1.1",
    "@mistralai/mistralai": "^1.9.18",
    "@modelcontextprotocol/sdk": "1.12.0",
    "@qdrant/js-client-rest": "^1.14.0",
    "@roo-code/cloud": "workspace:^",
    "@roo-code/core": "workspace:^",
    "@roo-code/ipc": "workspace:^",
    "@roo-code/telemetry": "workspace:^",
    "@roo-code/types": "workspace:^",
    "@vscode/codicons": "^0.0.36",
    "ai-sdk-provider-poe": "2.0.18",
    "async-mutex": "^0.5.0",
    "axios": "^1.12.0",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.1",
    "clone-deep": "^4.0.1",
    "default-shell": "^2.2.0",
    "delay": "^6.0.0",
    "diff": "^5.2.0",
    "diff-match-patch": "^1.0.5",
    "exceljs": "^4.4.0",
    "fast-deep-equal": "^3.1.3",
    "fastest-levenshtein": "^1.0.16",
    "fzf": "^0.5.2",
    "get-folder-size": "^5.0.0",
    "global-agent": "^3.0.0",
    "google-auth-library": "^9.15.1",
    "gray-matter": "^4.0.3",
    "i18next": "^25.0.0",
    "ignore": "^7.0.3",
    "isbinaryfile": "^5.0.7",
    "json-stream-stringify": "^3.1.6",
    "jwt-decode": "^4.0.0",
    "lodash.debounce": "^4.0.8",
    "mammoth": "^1.9.1",
    "monaco-vscode-textmate-theme-converter": "^0.1.7",
    "node-cache": "^5.1.2",
    "node-ipc": "^12.0.0",
